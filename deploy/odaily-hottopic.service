[Unit]
Description=OdAIly independent HotTopic collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/OdAIly
EnvironmentFile=-/opt/OdAIly/.env
Environment=PYTHONUNBUFFERED=1
Environment=HOTTOPIC_MODEL=odaily-gpt-writer
ExecStart=/opt/OdAIly/.venv/bin/python backend/src/main.py hottopic-worker --seed --workers 8
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
