[Unit]
Description=OdAIly independent HotTopic collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/OdAIly
EnvironmentFile=-/opt/OdAIly/.env
Environment=PYTHONUNBUFFERED=1
Environment=HOTTOPIC_MODEL=gpt-6-luna
Environment=HOTTOPIC_FALLBACK_MODEL=gpt-6-luna
Environment=HOTTOPIC_CLAIM_REVIEW_ENABLED=true
Environment=HOTTOPIC_CLAIM_REVIEW_MODEL=gpt-6-luna
Environment=HOTTOPIC_CLAIM_REVIEW_FALLBACK_MODEL=gpt-6-luna
Environment=HOTTOPIC_CLAIM_REVIEW_REASONING_EFFORT=high
Environment=HOTTOPIC_MIN_REQUEST_INTERVAL_SECONDS=0.10
ExecStart=/opt/OdAIly/.venv/bin/python backend/src/main.py hottopic-worker --seed --workers 128
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
