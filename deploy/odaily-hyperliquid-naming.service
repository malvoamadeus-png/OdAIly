[Unit]
Description=OdAIly Hyperliquid address naming worker
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/data/OdAIly/hyperliquid

[Service]
Type=simple
WorkingDirectory=/opt/OdAIly
EnvironmentFile=-/opt/OdAIly/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/OdAIly/.venv/bin/python backend/src/main.py hyperliquid-news run-naming --batch-size 4 --interval-seconds 30
Restart=always
RestartSec=10
TimeoutStopSec=30
User=root
Group=root

[Install]
WantedBy=multi-user.target
