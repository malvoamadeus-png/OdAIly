[Unit]
Description=OdAIly external media alert %i worker
After=network-online.target postgresql.service
Requires=postgresql.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/OdAIly
EnvironmentFile=-/opt/OdAIly/.env
EnvironmentFile=/etc/odaily/postgresql.env
Environment=ODAILY_STORAGE_BACKEND=postgres
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/OdAIly/.venv/bin/python backend/src/main.py external-media-alert-worker --stage %i
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
