[Unit]
Description=OdAIly x-processing %i worker
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/data/OdAIly/system-observability

[Service]
Type=simple
WorkingDirectory=/opt/OdAIly
EnvironmentFile=-/opt/OdAIly/.env
Environment=PYTHONUNBUFFERED=1
Environment=ODAILY_SYSTEM_OBSERVABILITY_DIR=/data/OdAIly/system-observability
ExecStart=/opt/OdAIly/.venv/bin/python backend/src/main.py x-process-worker --stage %i
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
