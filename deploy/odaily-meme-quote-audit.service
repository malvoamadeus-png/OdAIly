[Unit]
Description=OdAIly Solana Meme quote audit worker
After=network-online.target odaily-meme-scanner.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/OdAIly
EnvironmentFile=-/opt/OdAIly/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/OdAIly/.venv/bin/python backend/src/main.py meme quote-audit
Restart=no
RestartSec=10

[Install]
WantedBy=multi-user.target
