OKX_PASSPHRASE=
OKX_API_BASE_URL=https://web3.okx.com
MEME_OKX_TIMEOUT_SECONDS=20
MEME_OKX_MAX_ATTEMPTS=3
# Disabled by default to avoid signed API quota usage; enable for OKX details/risk metadata.
MEME_OKX_DETAILS_ENABLED=false
# shadow records OKX risk flags; block also rejects high phishing/top10 concentration.
MEME_OKX_RISK_MODE=shadow
# Price metrics for BSC/Robinhood: okx (default) or gmgn. Discovery remains OKX MemePump web.
MEME_PRICE_SOURCE=okx
# Concurrent GMGN token-info lookups when enriching a discovery page (keep below the GMGN burst limit).
MEME_GMGN_PRICE_WORKERS=4
# Minimum spacing between all GMGN token-info process starts in this scanner.
MEME_GMGN_REQUEST_INTERVAL_SECONDS=0.15
